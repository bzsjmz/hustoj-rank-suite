# Copy this file to .env. Never store passwords, cookies, tickets, or tokens here.
WEBVPN_ORIGIN=https://webvpn.example.edu
WEBVPN_LOGIN_URL=https://webvpn.example.edu/
# Copy the proxy URL from a normal, authorized WebVPN visit to ranklist.php.
OJ_PROXY_BASE=https://webvpn.example.edu/http/replace-with-proxy-token

# Primary cohort used by leaderboards and historical roster statistics.
OJ_PREFIX=2026
# Additional cohorts available only to /查榜. Must include OJ_PREFIX.
OJ_LOOKUP_PREFIXES=2023,2024,2025,2026

# Student-ID layout. Example: 2026 + 1001 (major) + 01 (class) + 01 (student).
STUDENT_ID_LENGTH=12
MAJOR_CODE_LENGTH=4
CLASS_CODE_LENGTH=6
# Full-match character policy; length is enforced separately.
STUDENT_ID_PATTERN=[0-9]+

# Comma- or whitespace-separated service/test accounts excluded from snapshots.
OJ_EXCLUDED_USER_IDS=
# Optional deployment-specific split: users in this snapshot are college A; later users are college B.
COLLEGE_SPLIT_SNAPSHOT_ID=1

SCRAPE_INTERVAL_SECONDS=300
LOGIN_CHECK_SECONDS=60
AUTH_RECOVERY_WAIT_MS=5000
ERROR_RETRY_SECONDS=60
RANK_PAGE_SIZE=50
MAX_PAGES=100
PAGE_TIMEOUT_MS=45000

# Independent renderer: eagerly cache only the first N pages of frequently used boards.
# Other pages, plus weekly/monthly boards, are rendered on demand through a Unix socket.
PRE_RENDER_PAGES=3
RENDER_POLL_SECONDS=3
RENDER_REQUEST_TIMEOUT=90
# OJ_RENDER_RUN_DIR=/srv/hustoj-rank-service/run

# Defaults are project-local data/, logs/, share/, and data/webvpn-profile/.
# OJ_DATA_DIR=/srv/hustoj-rank-service/data
# OJ_LOG_DIR=/srv/hustoj-rank-service/logs
# OJ_SHARE_DIR=/srv/hustoj-rank-service/share
# WEBVPN_PROFILE_DIR=/srv/hustoj-rank-service/data/webvpn-profile

# Keep false when using Xvfb/noVNC for manual authentication.
BROWSER_HEADLESS=false
# Usually leave blank to use Playwright's bundled Chromium.
# BROWSER_EXECUTABLE=/usr/bin/chromium
# PLAYWRIGHT_BROWSERS_PATH=/srv/hustoj-rank-service/data/ms-playwright

# Render socket admission (independent of the task queue)
RENDER_MAX_CONNECTIONS=64
RENDER_SOCKET_TIMEOUT=5

# On-demand submission queries share the authenticated collector browser.
# Concurrent requests for one student are merged and successful results cached briefly.
SUBMISSION_QUEUE_LIMIT=16
SUBMISSION_CACHE_SECONDS=60
SUBMISSION_REQUESTS_PER_MINUTE=20
SUBMISSION_MAX_CONNECTIONS=32
SUBMISSION_SOCKET_TIMEOUT=5
SUBMISSION_REQUEST_TIMEOUT=90

# Optional private school mapping JSON, never commit the real deployment file
OJ_MAJOR_LABELS_FILE=
